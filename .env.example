# MarketLens environment template
# Copy this file to .env, then fill in local or deployment-specific values:
#   cp .env.example .env
#
# The backend reads .env through pydantic-settings. CRACO also reads the
# frontend-safe REACT_APP_* values below from this same root file at build time.
# .env is gitignored; this template is committed.
# Omitted keys use the defaults in backend/config/settings.py. Blank values are
# placeholders for credentials or optional settings.

# ---------------------------------------------------------------------------
# Frontend
# Build-time API base URL used by the React application.
# FRONTEND_PORT is the CRA development-server port used by the local launchers.
# ---------------------------------------------------------------------------
REACT_APP_API_BASE_URL=http://localhost:5001/api
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# Application runtime
# DEBUG is intended for local development. HOST and PORT are used when running
# `python -m backend.api.main` directly. The development launchers use these
# values for the API and FRONTEND_PORT for CRA's development server.
# ---------------------------------------------------------------------------
DEBUG=false
HOST=0.0.0.0
PORT=5001
# full starts live market-data services. api keeps local UI/API work fast:
# it skips provider initialization, automatic ingestion, streaming, and warmups.
STARTUP_MODE=full

# ---------------------------------------------------------------------------
# Database
# The application intentionally uses <project_root>/marketlens.db so the
# database location does not depend on the process working directory.
# DATABASE_URL is retained as a legacy template key but is ignored by the
# current DatabaseSettings. To use another database, set MARKETLENS_DB_OVERRIDE
# in the process environment (for example, for tests or PostgreSQL).
# DATABASE_ECHO controls SQLAlchemy statement logging. DATABASE_POOL_SIZE is
# retained for settings compatibility; the current SQLite engine uses its own
# pool sizing and does not consume this value.
# The DATABASE_URL placeholder below documents the former configuration shape
# and has no effect unless the application code changes.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:////absolute/path/to/your/project/marketlens.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5

# ---------------------------------------------------------------------------
# CORS
# JSON array of browser origins allowed to call the API. Include the local
# frontend origin during development; use only trusted HTTPS origins in production.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5001"]

# ---------------------------------------------------------------------------
# API rate limiting
# Limits apply to mutation endpoints. WINDOW_SECONDS is the rolling window and
# MAX_REQUESTS_PER_WINDOW is the per-IP request budget.
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=30

# ---------------------------------------------------------------------------
# Market data providers
# PRIMARY selects the first provider for live quotes and bars. FALLBACK_PROVIDERS
# is an ordered JSON array used when the primary is unavailable or returns no data.
# CACHE_TTL_SECONDS controls how long fetched data may be reused.
# BACKFILL_ON_ADD queues historical data when a symbol is first watched.
# Per-provider rate limits cap requests per minute; keep them within provider terms.
# ---------------------------------------------------------------------------
MARKET_DATA_PRIMARY_PROVIDER=webull
MARKET_DATA_FALLBACK_PROVIDERS=["alpaca","yahoo_finance","finnhub"]
MARKET_DATA_YAHOO_FINANCE_RATE_LIMIT_PER_MINUTE=60
MARKET_DATA_FINNHUB_RATE_LIMIT_PER_MINUTE=1200
MARKET_DATA_WEBULL_RATE_LIMIT_PER_MINUTE=100
MARKET_DATA_ALPACA_RATE_LIMIT_PER_MINUTE=190
MARKET_DATA_CACHE_TTL_SECONDS=120
MARKET_DATA_BACKFILL_ON_ADD=true

# ---------------------------------------------------------------------------
# Backfill provider chains
# Each timeframe has an independent primary + fallback chain. PRIMARY is tried
# first; FALLBACK entries are tried in order when PRIMARY returns no usable bars.
# The 1m GAPFILL setting covers only the most recent short data lag; it is not a
# general history fallback. DAYS values are maximum calendar-day windows, and a
# CLI --days override can only shorten them.
# ---------------------------------------------------------------------------
# 1m: webull primary, yahoo_finance gapfill, alpaca fallback.
BACKFILL_1M_PRIMARY=webull
BACKFILL_1M_GAPFILL=yahoo_finance
BACKFILL_1M_FALLBACK=alpaca
BACKFILL_1M_DAYS=15

# 1h: webull primary; alpaca and yahoo_finance are fallback providers. The
# fallback chain helps capture the 16:00 ET close bar that :00-anchored bars omit.
BACKFILL_1H_PRIMARY=webull
BACKFILL_1H_FALLBACK=alpaca,yahoo_finance
BACKFILL_1H_DAYS=365

# 1d: webull primary; use different fallback providers so degraded primary data
# has a real alternate source.
BACKFILL_1D_PRIMARY=webull
BACKFILL_1D_FALLBACK=yahoo_finance,alpaca
BACKFILL_1D_DAYS=1095

# ---------------------------------------------------------------------------
# Bar storage retention
# Bars older than the configured window are pruned during ingestion. Keep each
# retention window at least one day longer than the matching BACKFILL_*_DAYS
# value so newly backfilled history is not removed immediately. Intraday
# timeframes are high-volume and use shorter windows; longer timeframes retain
# more history because their row volume is compact.
# ---------------------------------------------------------------------------
RETENTION_TF_1M_DAYS=16
RETENTION_TF_2M_DAYS=16
RETENTION_TF_3M_DAYS=16
RETENTION_TF_5M_DAYS=16
RETENTION_TF_15M_DAYS=16
RETENTION_TF_30M_DAYS=16
RETENTION_TF_1H_DAYS=366
RETENTION_TF_4H_DAYS=366
RETENTION_TF_1D_DAYS=1096
RETENTION_TF_1WK_DAYS=1096

# ---------------------------------------------------------------------------
# Alpaca provider (optional; REST + WebSocket market data)
# Enable only with valid credentials. PAPER=true selects the paper environment.
# DATA_TIER=iex uses the free IEX data tier; sip requires an eligible plan.
# REQUEST_TIMEOUT controls provider HTTP calls.
# ALPACA_RATE_LIMIT_PER_MINUTE is retained for compatibility but is not read by
# the current Alpaca settings; market-data throttling uses
# MARKET_DATA_ALPACA_RATE_LIMIT_PER_MINUTE.
# ---------------------------------------------------------------------------
ALPACA_ENABLED=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_TIER=iex                               # iex (free) | sip (paid)
ALPACA_RATE_LIMIT_PER_MINUTE=190
ALPACA_REQUEST_TIMEOUT=10.0

# ---------------------------------------------------------------------------
# Webull provider (optional; REST + optional streaming)
# Requires WEBULL_APP_KEY and WEBULL_APP_SECRET from Webull Open Platform.
# The auth token is held in process memory and is not persisted to disk.
# USE_SANDBOX=false selects the production Webull environment.
# STREAMING_ENABLED controls the optional MQTT Time & Sales feed.
# WEBULL_RATE_LIMIT_PER_MINUTE is a provider setting; market-data request
# throttling uses MARKET_DATA_WEBULL_RATE_LIMIT_PER_MINUTE.
# ---------------------------------------------------------------------------
WEBULL_ENABLED=true
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_USE_SANDBOX=false
WEBULL_RATE_LIMIT_PER_MINUTE=100
WEBULL_REQUEST_TIMEOUT=15.0
WEBULL_STREAMING_ENABLED=false
# TAPE_ENABLED=true enables Time & Sales analytics when streaming is available.
TAPE_ENABLED=false

# ---------------------------------------------------------------------------
# Finnhub provider (optional; REST market and company data)
# Requires FINNHUB_API_KEY when enabled. REQUEST_TIMEOUT controls provider calls.
# FINNHUB_RATE_LIMIT_PER_MINUTE is a provider setting; market-data request
# throttling uses MARKET_DATA_FINNHUB_RATE_LIMIT_PER_MINUTE.
# ---------------------------------------------------------------------------
FINNHUB_ENABLED=true
FINNHUB_API_KEY=
FINNHUB_RATE_LIMIT_PER_MINUTE=1200
FINNHUB_REQUEST_TIMEOUT=5.0

# ---------------------------------------------------------------------------
# AI / LLM (optional)
# AI_ENABLED gates AI calls; the quantitative engine remains available when AI
# is disabled. AI_PROVIDER selects the primary provider type. AI_BASE_URL must
# include /v1 for an OpenAI-compatible gateway; local Ollama/LM Studio providers
# can use their default endpoints. AI_API_KEY is required only by providers that
# authenticate requests. AI_MODEL selects the primary model.
#
# AI_FALLBACK_PROVIDERS is an ordered comma-separated chain. Entries may be
# "type" or "type:model"; the model suffix is the only fallback model override.
# A matching provider type reuses the primary URL/key; other types use defaults.
# AI_CHAT_MODEL overrides the model for chat only. The backtest tool and trade
# plan tracking are opt-in because they add compute and persistence work.
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDERS=
AI_MODEL=llama3.2
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
AI_TIMEOUT=30.0
AI_HEALTH_CHECK_TIMEOUT=2.0
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.3
AI_CHAT_MODEL=
AI_BACKTEST_TOOL_ENABLED=false
AI_TRADE_PLAN_TRACKING_ENABLED=false

# ---------------------------------------------------------------------------
# AI digest (optional)
# The digest service runs at the configured Eastern Time premarket and close
# slots. It is a small dedicated scheduler, not a general-purpose job scheduler.
# TOP_MOVERS_COUNT bounds paid AI calls; regime, RSI extremes, and MTF counts
# are computed locally.
# ---------------------------------------------------------------------------
AI_DIGEST_ENABLED=true
AI_DIGEST_PREMARKET_HOUR=8
AI_DIGEST_PREMARKET_MINUTE=30
AI_DIGEST_CLOSE_HOUR=16
AI_DIGEST_CLOSE_MINUTE=15
AI_DIGEST_TOP_MOVERS_COUNT=5

# ---------------------------------------------------------------------------
# Multi-Timeframe Engine
# DEFAULT_PRESET selects the default analysis horizon. WEIGHTS are normalized
# internally, so they do not need to sum to 1.
# ---------------------------------------------------------------------------
MTF_DEFAULT_PRESET=day_trading
MTF_WEIGHTS={"1m":0.20,"5m":0.20,"15m":0.20,"30m":0.15,"1h":0.10,"4h":0.08,"1d":0.05,"1wk":0.02}

# ---------------------------------------------------------------------------
# Market Context Engine
# INDICES are the symbols used to derive the aggregate market regime.
# CONSENSUS_THRESHOLD is the number of sub-regimes that must agree.
# VIX thresholds define risk-on, risk-off, and transition behavior.
# ---------------------------------------------------------------------------
MARKET_CONTEXT_INDICES=["SPY","QQQ","IWM","^VIX"]
MARKET_CONTEXT_CONSENSUS_THRESHOLD=3
MARKET_CONTEXT_VIX_RISK_ON_MAX=15.0
MARKET_CONTEXT_VIX_RISK_OFF_MIN=25.0
MARKET_CONTEXT_VIX_SPIKE_THRESHOLD=0.05

# ---------------------------------------------------------------------------
# Relative Strength
# BENCHMARKS are comma-separated symbols. LOOKBACK_DAYS sets the comparison
# window; the remaining values define classification bands for return delta.
# ---------------------------------------------------------------------------
RELATIVE_STRENGTH_BENCHMARKS=SPY,QQQ
RELATIVE_STRENGTH_LOOKBACK_DAYS=20
RELATIVE_STRENGTH_STRONG_OUTPERFORMER_THRESHOLD=0.05
RELATIVE_STRENGTH_OUTPERFORMER_THRESHOLD=0.01
RELATIVE_STRENGTH_UNDERPERFORMER_THRESHOLD=-0.01
RELATIVE_STRENGTH_STRONG_UNDERPERFORMER_THRESHOLD=-0.05

# ---------------------------------------------------------------------------
# Auxiliary data providers
# News, fundamentals, and options are independently enabled. Provider names
# must match the registered provider identifiers. RATE_LIMIT and TIMEOUT
# protect each auxiliary data call.
# ---------------------------------------------------------------------------
AUX_NEWS_ENABLED=true
AUX_NEWS_PRIMARY_PROVIDER=yfinance_news
AUX_NEWS_FALLBACK_PROVIDERS=[]
AUX_NEWS_RATE_LIMIT_PER_MINUTE=20
AUX_NEWS_REQUEST_TIMEOUT=10.0

AUX_FUNDAMENTALS_ENABLED=true
AUX_FUNDAMENTALS_PRIMARY_PROVIDER=yfinance_fundamentals
AUX_FUNDAMENTALS_FALLBACK_PROVIDERS=[]
AUX_FUNDAMENTALS_RATE_LIMIT_PER_MINUTE=20
AUX_FUNDAMENTALS_REQUEST_TIMEOUT=10.0

AUX_OPTIONS_ENABLED=true
AUX_OPTIONS_PRIMARY_PROVIDER=yfinance_options
AUX_OPTIONS_FALLBACK_PROVIDERS=[]
AUX_OPTIONS_RATE_LIMIT_PER_MINUTE=20
AUX_OPTIONS_REQUEST_TIMEOUT=10.0

# ---------------------------------------------------------------------------
# Redis
# Used for market-data caching, distributed rate limiting, pub/sub, and RQ jobs
# when enabled. REDIS_URL points at the Redis server; REDIS_PASSWORD is optional.
# TTL values are seconds and key caps bound cache memory usage.
# ---------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_BAR_DATA_TTL=300
REDIS_QUOTE_TTL=60
REDIS_MAX_BAR_KEYS=1000
REDIS_MAX_QUOTE_KEYS=1000

# ---------------------------------------------------------------------------
# Observability
# TRACING is disabled by default for local development. The configured port is
# the standard OTLP/gRPC endpoint; enable tracing only when a compatible
# collector is running. METRICS and STRUCTURED_LOGGING control their respective
# sinks. SQL query logging is off by default to avoid noisy output.
# STRUCTURED_LOG_LEVEL sets log verbosity.
# ---------------------------------------------------------------------------
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_JAEGER_AGENT_HOST=localhost
OBSERVABILITY_JAEGER_AGENT_PORT=4317
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_SQLALCHEMY_QUERY_LOGGING=false
OBSERVABILITY_STRUCTURED_LOGGING_ENABLED=true
OBSERVABILITY_STRUCTURED_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Security headers
# HSTS must only be enabled when HTTPS is enforced end to end. CSP, framing,
# MIME-sniffing, referrer, and browser-feature policies protect API responses.
# SECURITY_CSP_VALUE can override the default strict JSON-API policy when needed.
# ---------------------------------------------------------------------------
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
SECURITY_CSP_ENABLED=true
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_X_CONTENT_TYPE_OPTIONS=true
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY=accelerometer=(),camera=(),geolocation=(),gyroscope=(),magnetometer=(),microphone=(),payment=(),usb=()

# ---------------------------------------------------------------------------
# Watchlists
# Limits apply per watchlist and across the account. AUTO_SAVE_ENABLED controls
# whether edits are persisted immediately.
# ---------------------------------------------------------------------------
WATCHLIST_MAX_SYMBOLS_PER_WATCHLIST=50
WATCHLIST_MAX_WATCHLISTS=10
WATCHLIST_AUTO_SAVE_ENABLED=true

# ---------------------------------------------------------------------------
# Background processing (RQ workers)
# BACKGROUND_ENABLED gates queue use. QUEUE_NAME handles AI analysis and alert
# delivery jobs;
# BACKFILL_QUEUE_NAME handles historical bar backfills so neither workload
# starves the other. RESULT_TTL is the Redis result lifetime in seconds.
# JOB_TIMEOUT is the maximum time a queued job may run.
# ---------------------------------------------------------------------------
BACKGROUND_ENABLED=true
BACKGROUND_QUEUE_NAME=marketlens-workers
BACKGROUND_BACKFILL_QUEUE_NAME=marketlens-backfill
BACKGROUND_RESULT_TTL=3600
BACKGROUND_JOB_TIMEOUT=600

# ---------------------------------------------------------------------------
# Alert notifications
# In-app and browser delivery require no server credentials. Webhook and email
# channels are configured per alert; SMTP values below enable server-side email.
# ---------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_REQUEST_TIMEOUT=5
NOTIFICATIONS_RETRY_MAX=3
NOTIFICATIONS_RETRY_BACKOFF_SECONDS=30
NOTIFICATIONS_SMTP_HOST=
NOTIFICATIONS_SMTP_PORT=587
NOTIFICATIONS_SMTP_USERNAME=
NOTIFICATIONS_SMTP_PASSWORD=
NOTIFICATIONS_SMTP_FROM=

# ---------------------------------------------------------------------------
# Trend and data-quality internals
# These nested settings use bare, unprefixed field names rather than a dedicated
# environment prefix. Prefer code changes for production behavior; only use
# unprefixed environment overrides when the naming and precedence are intentional.
# ---------------------------------------------------------------------------

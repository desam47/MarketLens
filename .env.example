# MarketLens — Environment Variables Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Keys are read by pydantic-settings at startup.
# Empty values (or commented-out keys) use the defaults hardcoded in
# backend/config/settings.py.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Format: sqlite:///./marketlens.db  (relative path from repo root)
# Or: postgresql://user:pass@localhost:5432/marketlens
DATABASE_URL=sqlite:///./marketlens.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# Always include http://localhost:3000 for local frontend dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=30

# ---------------------------------------------------------------------------
# Market Data
# ---------------------------------------------------------------------------
# Primary provider for live market data. Options: yahoo_finance (more free providers coming)
MARKET_DATA_PRIMARY_PROVIDER=yahoo_finance
# Fallback providers tried in order when primary fails (comma-separated)
MARKET_DATA_FALLBACK_PROVIDERS=
MARKET_DATA_RATE_LIMIT_PER_MINUTE=60
# Cache TTL for historical bars in seconds
MARKET_DATA_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# AI (Phase 15 — optional)
# ---------------------------------------------------------------------------
# Set to true to enable AI-powered analysis.
AI_ENABLED=false
# Provider: openai, anthropic, etc.
AI_PROVIDER=openai
AI_MODEL=gpt-3.5-turbo
# Leave blank to use the AI_API_KEY env var directly, or set it here.
AI_API_KEY=
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# Watchlists
# ---------------------------------------------------------------------------
WATCHLIST_MAX_SYMBOLS_PER_WATCHLIST=50
WATCHLIST_MAX_WATCHLISTS=10
WATCHLIST_AUTO_SAVE_ENABLED=true

# ---------------------------------------------------------------------------
# Trend engine internals (DO NOT SET unless you know what you're doing)
# ---------------------------------------------------------------------------
# The following are hardcoded in backend/config/settings.py and are NOT
# controlled by env vars. To change them, edit the settings file directly:
#
#   TrendSignalWeights     — indicator score weights (ema, rsi, macd, adx, ...)
#   IndicatorDefaults      — indicator periods (rsi_period, macd_fast/slow/signal, ...)
#   TrendSettings          — timeframe weights, strategy_version
#   DataQualitySettings    — tick gap / stale / duplicate thresholds
#
# These are intentionally not env-driven to keep production behaviour stable.

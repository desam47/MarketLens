# MarketLens — Environment Variables Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Both the Python backend (pydantic-settings) and the React frontend (CRA)
# read from this single file. .env is gitignored; .env.example is committed.
#
# Empty values (or commented-out keys) use the defaults hardcoded in
# backend/config/settings.py.

# ---------------------------------------------------------------------------
# Frontend (CRA reads REACT_APP_* at build time)
# ---------------------------------------------------------------------------
REACT_APP_API_BASE_URL=http://localhost:5001/api

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Format: sqlite:////absolute/path/marketlens.db  (absolute path — REQUIRED)
# Using a relative path (sqlite:///./marketlens.db) causes data loss if you
# start the backend from any directory other than the repo root — the DB file
# gets created as a fresh empty DB in that directory, and your data disappears.
# Example absolute path for this project:
# IMPORTANT: DATABASE_URL is IGNORED by the app. The DB path is hard-coded to
# <project_root>/marketlens.db (computed from the settings module at import time).
# This prevents "watchlist disappears after restart from wrong CWD".
DATABASE_URL=sqlite:////absolute/path/to/your/project/marketlens.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# Always include http://localhost:3000 for local frontend dev.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5001"]

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=30

# ---------------------------------------------------------------------------
# Market Data
# ---------------------------------------------------------------------------
# Primary provider for live market data. Options: webull, alpaca, yahoo_finance, finnhub
MARKET_DATA_PRIMARY_PROVIDER=webull
# Fallback providers tried in order when primary fails (JSON array)
MARKET_DATA_FALLBACK_PROVIDERS=["alpaca","yahoo_finance","finnhub"]
# Per-provider rate limit overrides
MARKET_DATA_YAHOO_FINANCE_RATE_LIMIT_PER_MINUTE=60
MARKET_DATA_FINNHUB_RATE_LIMIT_PER_MINUTE=1200
MARKET_DATA_WEBULL_RATE_LIMIT_PER_MINUTE=100
MARKET_DATA_ALPACA_RATE_LIMIT_PER_MINUTE=190
# Cache TTL for historical bars in seconds
MARKET_DATA_CACHE_TTL_SECONDS=120
# Whether to trigger a full backfill when a symbol is first added to a watchlist.
# Set false to disable automatic backfill (useful for testing).
MARKET_DATA_BACKFILL_ON_ADD=true

# ---------------------------------------------------------------------------
# Backfill Provider Chains
# ---------------------------------------------------------------------------
# Each timeframe has an independent primary + fallback provider chain.
# The primary is tried first; if it returns no data, each fallback is tried in order.
#
# 1m bars: webull primary (6000 bar cap), yahoo_finance gapfill, alpaca fallback
BACKFILL_1M_PRIMARY=webull
BACKFILL_1M_GAPFILL=yahoo_finance
BACKFILL_1M_FALLBACK=alpaca
# Backfill window in calendar days — clamped down (never up) by an
# explicit --days override (e.g. scripts/backfill_1000d.py), otherwise
# used as-is.
BACKFILL_1M_DAYS=15
#
# 1h bars: webull primary (:00 clock-hour anchors), alpaca gap-fill (picks up 16:00 close bar),
#          yahoo_finance also fills the 16:00 bar
BACKFILL_1H_PRIMARY=webull
BACKFILL_1H_FALLBACK=alpaca,yahoo_finance
BACKFILL_1H_DAYS=365
#
# 1d bars — fallback MUST be a different provider than primary (webull here)
# or a rate-limited/degraded primary has no real fallback to fall through to.
BACKFILL_1D_PRIMARY=webull
BACKFILL_1D_FALLBACK=yahoo_finance,alpaca
BACKFILL_1D_DAYS=1095

# ---------------------------------------------------------------------------
# Bar Storage Retention
# ---------------------------------------------------------------------------
# The actual ongoing DB storage cap, per timeframe — enforced automatically
# by the rolling retention prune (runs on every ~60s ingestion tick that
# writes new bars). Bars older than a timeframe's window are deleted.
# 1m/2m/3m/5m/15m/30m are high-volume (especially with extended-hours 1m
# ingestion), so they default to a short window; 1h/4h/1d/1wk stay compact
# regardless, so they default to much longer windows.
RETENTION_TF_1M_DAYS=16
RETENTION_TF_2M_DAYS=16
RETENTION_TF_3M_DAYS=16
RETENTION_TF_5M_DAYS=16
RETENTION_TF_15M_DAYS=16
RETENTION_TF_30M_DAYS=16
RETENTION_TF_1H_DAYS=366
RETENTION_TF_4H_DAYS=366
RETENTION_TF_1D_DAYS=1096
RETENTION_TF_1WK_DAYS=1096

# ---------------------------------------------------------------------------
# Alpaca Provider (optional, free tier available)
# ---------------------------------------------------------------------------
# Set to true to enable Alpaca as a market data provider.
# Provides REST market data. Free tier uses IEX data.
# Sign up at https://app.alpaca.markets/
ALPACA_ENABLED=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_TIER=iex                               # iex (free) | sip (paid)
ALPACA_RATE_LIMIT_PER_MINUTE=190
ALPACA_REQUEST_TIMEOUT=10.0

# ---------------------------------------------------------------------------
# Webull Provider (optional, requires Webull Open Platform credentials)
# ---------------------------------------------------------------------------
# Requires WEBULL_APP_KEY and WEBULL_APP_SECRET from Webull Open Platform.
# Token is held in-process memory only — not persisted to disk.
WEBULL_ENABLED=true
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_USE_SANDBOX=false
WEBULL_RATE_LIMIT_PER_MINUTE=100
WEBULL_REQUEST_TIMEOUT=15.0

# ---------------------------------------------------------------------------
# Finnhub Provider (optional, free tier)
# ---------------------------------------------------------------------------
FINNHUB_ENABLED=true
FINNHUB_API_KEY=
FINNHUB_RATE_LIMIT_PER_MINUTE=1200
FINNHUB_REQUEST_TIMEOUT=5.0

# ---------------------------------------------------------------------------
# AI (optional)
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=ollama                                 # ollama | openai | anthropic
AI_FALLBACK_PROVIDERS=
AI_MODEL=llama3.2
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
AI_TIMEOUT=30.0
AI_HEALTH_CHECK_TIMEOUT=2.0
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.3

# ---------------------------------------------------------------------------
# Multi-Timeframe Engine
# ---------------------------------------------------------------------------
MTF_DEFAULT_PRESET=day_trading
# Per-timeframe weights (sum normalized internally)
MTF_WEIGHTS={"1m":0.20,"5m":0.20,"15m":0.20,"30m":0.15,"1h":0.10,"4h":0.08,"1d":0.05,"1wk":0.02}

# ---------------------------------------------------------------------------
# Market Context Engine
# ---------------------------------------------------------------------------
MARKET_CONTEXT_INDICES=["SPY","QQQ","IWM","^VIX"]
MARKET_CONTEXT_CONSENSUS_THRESHOLD=3
MARKET_CONTEXT_VIX_RISK_ON_MAX=15.0
MARKET_CONTEXT_VIX_RISK_OFF_MIN=25.0
MARKET_CONTEXT_VIX_SPIKE_THRESHOLD=0.05

# ---------------------------------------------------------------------------
# Relative Strength
# ---------------------------------------------------------------------------
RELATIVE_STRENGTH_BENCHMARKS=SPY,QQQ
RELATIVE_STRENGTH_LOOKBACK_DAYS=20
RELATIVE_STRENGTH_STRONG_OUTPERFORMER_THRESHOLD=0.05
RELATIVE_STRENGTH_OUTPERFORMER_THRESHOLD=0.01
RELATIVE_STRENGTH_UNDERPERFORMER_THRESHOLD=-0.01
RELATIVE_STRENGTH_STRONG_UNDERPERFORMER_THRESHOLD=-0.05

# ---------------------------------------------------------------------------
# Auxiliary Data Providers (news, fundamentals, options)
# ---------------------------------------------------------------------------
AUX_NEWS_ENABLED=false
AUX_NEWS_PRIMARY_PROVIDER=yfinance_news
AUX_NEWS_FALLBACK_PROVIDERS=[]
AUX_NEWS_RATE_LIMIT_PER_MINUTE=20
AUX_NEWS_REQUEST_TIMEOUT=10.0

AUX_FUNDAMENTALS_ENABLED=false
AUX_FUNDAMENTALS_PRIMARY_PROVIDER=yfinance_fundamentals
AUX_FUNDAMENTALS_FALLBACK_PROVIDERS=[]
AUX_FUNDAMENTALS_RATE_LIMIT_PER_MINUTE=20
AUX_FUNDAMENTALS_REQUEST_TIMEOUT=10.0

AUX_OPTIONS_ENABLED=false
AUX_OPTIONS_PRIMARY_PROVIDER=yfinance_options
AUX_OPTIONS_FALLBACK_PROVIDERS=[]
AUX_OPTIONS_RATE_LIMIT_PER_MINUTE=20
AUX_OPTIONS_REQUEST_TIMEOUT=10.0

# ---------------------------------------------------------------------------
# Redis (caching, rate limiting, pub/sub)
# ---------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_BAR_DATA_TTL=300
REDIS_QUOTE_TTL=60
REDIS_MAX_BAR_KEYS=1000
REDIS_MAX_QUOTE_KEYS=1000

# ---------------------------------------------------------------------------
# Observability (tracing, metrics, structured logging)
# ---------------------------------------------------------------------------
# CAUTION: OBSERVABILITY_JAEGER_AGENT_PORT=6831 below is Jaeger's legacy UDP
# *agent* port, not a valid OTLP/gRPC endpoint (that's 4317) — the exporter
# tracing.py builds from these two settings will not actually reach Jaeger.
# FastAPIInstrumentor wraps EVERY request, so a doomed export attempt on
# every single request is a real, noticeable page-load slowdown (found live
# 2026-09-09 — see docs/Version_3/phase_audit_v3.md, Phase 3.10). Leave this
# disabled unless you point it at a real OTLP collector (e.g. port 4317).
OBSERVABILITY_TRACING_ENABLED=true
OBSERVABILITY_JAEGER_AGENT_HOST=localhost
OBSERVABILITY_JAEGER_AGENT_PORT=6831
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_SQLALCHEMY_QUERY_LOGGING=false
OBSERVABILITY_STRUCTURED_LOGGING_ENABLED=true
OBSERVABILITY_STRUCTURED_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Security Headers (HTTP security headers on every response)
# ---------------------------------------------------------------------------
# Strict-Transport-Security — only enable when HTTPS is enforced end-to-end.
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
# Content-Security-Policy — default is strict JSON-API policy.
SECURITY_CSP_ENABLED=true
# Clickjacking protection.
SECURITY_X_FRAME_OPTIONS=DENY
# MIME-type sniffing protection.
SECURITY_X_CONTENT_TYPE_OPTIONS=true
# Referrer header on cross-origin requests.
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# Disable browser feature tracking (FLoC).
SECURITY_PERMISSIONS_POLICY=accelerometer=(),camera=(),geolocation=(),gyroscope=(),magnetometer=(),microphone=(),payment=(),usb=()

# ---------------------------------------------------------------------------
# Watchlists
# ---------------------------------------------------------------------------
WATCHLIST_MAX_SYMBOLS_PER_WATCHLIST=50
WATCHLIST_MAX_WATCHLISTS=10
WATCHLIST_AUTO_SAVE_ENABLED=true

# ---------------------------------------------------------------------------
# Background AI job queue (Phase 2.5 — RQ)
# ---------------------------------------------------------------------------
# Master switch for the background job queue. If false, the API returns
# 503 from POST /api/ai/jobs and the worker has nothing to do.
BACKGROUND_ENABLED=true
# RQ queue name — workers must be started with the same name.
#   rq worker --url redis://localhost:6379/0 --worker-class rq.worker.SimpleWorker marketlens-workers
BACKGROUND_QUEUE_NAME=marketlens-workers
# Separate RQ queue for the symbol-history backfill pipeline (kept apart
# from QUEUE_NAME so a slow backfill can't starve AI analysis jobs).
#   rq worker --url redis://localhost:6379/0 --worker-class rq.worker.SimpleWorker marketlens-backfill
# Run two instances for the concurrency-cap-of-2 the old in-process
# semaphore used to enforce.
BACKGROUND_BACKFILL_QUEUE_NAME=marketlens-backfill
# Result TTL (seconds) — how long completed results stay in Redis.
BACKGROUND_RESULT_TTL=3600
# Per-job timeout (seconds) — jobs taking longer than this are killed.
BACKGROUND_JOB_TIMEOUT=600

# ---------------------------------------------------------------------------
# Trend engine internals (DO NOT SET unless you know what you're doing)
# ---------------------------------------------------------------------------
# The following are hardcoded in backend/config/settings.py and are NOT
# controlled by env vars. To change them, edit the settings file directly:
#
#   TrendSignalWeights     — indicator score weights (ema, rsi, macd, adx, ...)
#   IndicatorDefaults      — indicator periods (rsi_period, macd_fast/slow/signal, ...)
#   TrendSettings          — timeframe weights, strategy_version
#   DataQualitySettings    — tick gap / stale / duplicate thresholds
#
# These are intentionally not env-driven to keep production behaviour stable.

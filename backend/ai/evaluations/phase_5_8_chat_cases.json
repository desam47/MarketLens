        {
          "user": "delete my Tech watchlist",
          "model": [
            {
              "reply": "Deleting it.",
              "grounded": true,
              "action": "delete_watchlist",
              "action_watchlist": "Tech"
            }
          ],
          "expect": {
            "step_status": {
              "delete_watchlist": "needs_confirmation"
            },
            "db": {
              "watchlists": {
                "Tech": [
                  "NVDA"
                ]
              },
              "pending_confirmation": {
                "action": "delete_watchlist"
              }
            }
          }
        },
        {
          "user": "yes",
          "model": [
            {
              "reply": "Done.",
              "grounded": true,
              "action": "none"
            }
          ],
          "allow_unscripted_model": true,
          "expect": {
            "db": {
              "watchlists": {
                "Tech": null
              },
              "pending_confirmation": null
            }
          }
        }
      ]
    },

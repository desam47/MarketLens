# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment
.env
.env.local
# Per-directory .env files are NOT supported — all config must live at the
# repo-root .env. Subfolder .env files are silently ignored by pydantic-settings
# (which reads env_file relative to CWD, not to the settings module) and
# historically caused confusion. See backend/config/settings.py _ENV_FILE.
backend/.env
frontend/.env

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Project data
# marketlens.db is a sqlite file produced by `scripts/init_db.py` and
# the backend at runtime. Per-symbol tick history is real data, so it
# must never be committed (size + privacy).
marketlens.db
*.db
*.sqlite
*.sqlite3
# WAL mode (Phase 3.3.1) creates these alongside the DB; Litestream
# (3.3.2) creates snapshot/wal files in its own directory.
*.db-wal
*.db-shm
.litestream/

# Logs
*.log
logs/
# Rotated SDK logs use a suffix before the extension (e.g. webull.log.2026-08-31_03)
*.log.*_*

# Node / React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.cache/

# Test client output
test_dashboard_api.js
__pycache__/

# Process state — generated by start.sh and the running server
*.pid
server.pid
backend/server.pid

# Coverage reports
htmlcov/
.coverage
coverage.xml
coverage/

# Webull SDK's own auth token cache — refreshed on every backend start,
# so tracking it means every restart dirties git status, and it's a live
# credential that has no business in version control.
conf/token.txt

# Local mypy cache (not covered by the .pytest_cache/.ruff_cache lines above)
.mypy_cache/

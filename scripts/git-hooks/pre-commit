#!/bin/bash
# pre-commit shim: version stamping moved to post-commit.
#
# A pre-commit hook runs BEFORE the new commit exists, so `git describe`
# can only ever see the previous commit — the stamp would permanently lag
# one commit behind. It also cannot coexist with the ruff/mypy `pre-commit`
# framework, whose `pre-commit install` overwrites .git/hooks/pre-commit.
#
# So the real logic lives in scripts/git-hooks/post-commit (correct by
# construction: HEAD exists after the commit). This shim only forwards to
# it, kept for backwards compatibility with clones whose
# .git/hooks/pre-commit symlink predates the move; `pre-commit install`
# replacing this file costs nothing because stamping no longer depends
# on the pre-commit slot.
#
# Install (once per clone):
#   ln -sf "$(git rev-parse --show-toplevel)/scripts/git-hooks/post-commit" .git/hooks/post-commit

set -euo pipefail

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [[ "$branch" == "main" ]]; then
  echo "Commits on main are disabled. Switch to development and commit there." >&2
  exit 1
fi

exec "$(git rev-parse --show-toplevel)/scripts/git-hooks/post-commit"
